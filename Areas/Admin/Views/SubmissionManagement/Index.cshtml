@{
    ViewData["Title"] = "Makale Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h4 class="mb-0">Makale Yönetimi</h4>
        <p class="text-muted small mb-0 mt-1">
            Sistemdeki tüm makalelerin salt okunur listesi. Durum değişiklikleri ilgili editör iş akışı ekranlarından yapılır.
        </p>
    </div>
    <div class="card-body">
        <table id="submissionTable" class="table table-striped table-bordered align-middle w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Başlık</th>
                    <th>Yazar</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                    <th style="width:120px;">İşlemler</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            return isNaN(date) ? '' : date.toLocaleString('tr-TR');
        }

        $(document).ready(function () {
            if ($.fn.DataTable.isDataTable('#submissionTable')) {
                $('#submissionTable').DataTable().destroy();
            }

            $('#submissionTable').DataTable({
                info: false,
                ajax: {
                    url: '/Admin/SubmissionManagement/GetSubmissions',
                    type: 'GET'
                },
                columns: [
                    { data: 'id' },
                    { data: 'title', render: function (d) { return escapeHtml(d); } },
                    { data: 'author', render: function (d) { return escapeHtml(d); } },
                    {
                        data: 'statusText',
                        render: function (data, type, row) {
                            // Durum metni ve renk sınıfı sunucuda StatusDisplayHelper'dan gelir
                            return `<span class="badge ${escapeHtml(row.statusBadgeClass)}">${escapeHtml(data)}</span>`;
                        }
                    },
                    {
                        data: 'createdAt',
                        render: function (data) { return formatDate(data); }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        searchable: false,
                        render: function (data) {
                            return `<a href="/Submission/Detail/${data}" class="btn btn-sm btn-info">Detay</a>`;
                        }
                    }
                ],
                order: [[0, 'desc']],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/tr.json'
                }
            });
        });
    </script>
}
