@model MyDergiApp.ViewModels.HomePageViewModel

@{
    Layout = "~/Views/Shared/_FrontLayout.cshtml";
    ViewData["Title"] = "Ana Sayfa";

    var journalTitle = string.IsNullOrWhiteSpace(Model.HeaderTitle)
        ? Model.JournalTitle
        : Model.HeaderTitle;

    var journalSubtitle = string.IsNullOrWhiteSpace(Model.HeaderSubtitle)
        ? Model.JournalSubtitle
        : Model.HeaderSubtitle;

    var heroTitle = Model.ShowBanner && !string.IsNullOrWhiteSpace(Model.BannerTitle)
        ? Model.BannerTitle
        : Model.HeroTitle;

    var heroDescription = Model.ShowBanner && !string.IsNullOrWhiteSpace(Model.BannerDescription)
        ? Model.BannerDescription
        : Model.HeroDescription;

    var heroLabel = Model.ShowBanner && !string.IsNullOrWhiteSpace(Model.BannerLabel)
        ? Model.BannerLabel
        : "Hakemli Akademik Dergi";
}

<style>
    :root {
        --front-primary: @(string.IsNullOrWhiteSpace(Model.PrimaryColor) ? "#1f4f8f" : Model.PrimaryColor);
        --front-accent: @(string.IsNullOrWhiteSpace(Model.SecondaryColor) ? "#b3261e" : Model.SecondaryColor);
        --front-bg: @(string.IsNullOrWhiteSpace(Model.BodyBgColor) ? "#f4f7fb" : Model.BodyBgColor);
        --front-dark: @(string.IsNullOrWhiteSpace(Model.TextColor) ? "#172033" : Model.TextColor);
    }

    body {
        background: var(--front-bg);
        color: var(--front-dark);
    }

    .journal-header {
        background: @(string.IsNullOrWhiteSpace(Model.HeaderBgColor) ? "linear-gradient(135deg, #ffffff 0%, #f8fbff 100%)" : Model.HeaderBgColor);
    }

    .journal-nav {
        background: @(string.IsNullOrWhiteSpace(Model.NavBgColor) ? "var(--front-primary)" : Model.NavBgColor);
    }
</style>

<div class="journal-home theme-@Model.ThemeName">

    <!-- ISSN BAR -->
    <section class="issn-bar">
        <div class="front-container issn-inner issn-inner-center">
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.PrintIssn))
                {
                    <strong>ISSN:</strong> 
                    @Model.PrintIssn
                }

                @if (!string.IsNullOrWhiteSpace(Model.PrintIssn) && !string.IsNullOrWhiteSpace(Model.OnlineIssn))
                {
                    <span class="issn-separator">|</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.OnlineIssn))
                {
                    <strong>e-ISSN:</strong> 
                    @Model.OnlineIssn
                }
            </div>
        </div>
    </section>

    <!-- HEADER / LOGO -->
    <section class="journal-header"
             style="@(string.IsNullOrWhiteSpace(Model.HeaderBackgroundImagePath)
                                     ? ""
                                     : $"background-image: linear-gradient(rgba(255,255,255,.78), rgba(255,255,255,.78)), url('{Model.HeaderBackgroundImagePath}'); background-size:cover; background-position:center;")">
        <div class="front-container journal-header-inner">
            <div class="journal-logo-area">
                @if (Model.ShowHeaderLogo && !string.IsNullOrWhiteSpace(Model.HeaderLogoPath))
                {
                    <div class="journal-logo journal-logo-img">
                        <img src="@Model.HeaderLogoPath" alt="@journalTitle" />
                    </div>
                }
                else
                {
                    <div class="journal-logo">
                        <span>@(string.IsNullOrWhiteSpace(journalTitle) ? "D" : journalTitle.Substring(0, 1))</span>
                    </div>
                }

                <div>
                    <h1>@journalTitle</h1>
                    <p>@journalSubtitle</p>
                </div>
            </div>

            <div class="journal-header-actions">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="header-btn header-btn-outline" asp-controller="Submission" asp-action="Makalelerim">Panelim</a>
                }
                else
                {
                    <a class="header-btn header-btn-outline" href="/Identity/Account/Login">Giriş Yap</a>
                    <a class="header-btn header-btn-primary" href="/Identity/Account/Register">Kayıt Ol</a>
                }
            </div>
        </div>
    </section>

    <!-- MENU -->
    <nav class="journal-nav">
        <div class="front-container nav-inner">
            <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
            <a href="#about">Dergi Hakkında</a>
            <a asp-controller="Issues" asp-action="Published">Yayınlanan Sayılar</a>
            <a href="#latest-articles">Son Makaleler</a>
            <a href="#announcements">Duyurular</a>
            <a href="#indexes">İndeksler</a>
            <a href="#contact">İletişim</a>
        </div>
    </nav>

    <!-- HERO -->
    <section class="hero-section">
        <div class="front-container hero-grid">
            <div class="hero-content">
                <span class="hero-badge">@heroLabel</span>

                <h2>@heroTitle</h2>

                <p>@heroDescription</p>

                <div class="hero-actions">
                    <a asp-controller="Issues" asp-action="Published" class="hero-btn hero-btn-primary">Yayınlanan Sayıları İncele</a>
                    <a href="#latest-articles" class="hero-btn hero-btn-secondary">Son Makaleler</a>
                </div>
            </div>

            <div class="hero-card">
                @if (Model.CurrentIssue != null)
                {
                    <h3>Güncel Sayı</h3>
                    <p class="hero-card-title">@Model.CurrentIssue.Title</p>

                    <p>
                        <strong>Cilt:</strong> @Model.CurrentIssue.Volume
                        <br />
                        <strong>Sayı:</strong> @Model.CurrentIssue.Number
                        <br />
                        <strong>Yıl:</strong> @Model.CurrentIssue.Year
                    </p>

                    @if (Model.CurrentIssue.PublishedDate.HasValue)
                    {
                        <p>
                            <strong>Yayın Tarihi:</strong>
                            @Model.CurrentIssue.PublishedDate.Value.ToString("dd.MM.yyyy")
                        </p>
                    }

                    <a asp-controller="Issues" asp-action="Published">Güncel sayıya git →</a>
                }
                else
                {
                    <h3>Güncel Sayı</h3>
                    <p class="hero-card-title">Henüz sayı yayımlanmadı</p>
                    <p>Derginin yayımlanan sayıları buradan görüntülenebilir.</p>
                    <a asp-controller="Issues" asp-action="Published">Sayıları görüntüle →</a>
                }
            </div>
        </div>
    </section>

    <!-- MAIN CONTENT -->
    <section class="front-main">
        <div class="front-container main-grid">

            <!-- LEFT CONTENT -->
            <div class="main-left">

                <!-- ABOUT -->
                <section id="about" class="content-card about-card">
                    <div class="section-heading">
                        <span>Hakkında</span>
                        <h2>@Model.AboutTitle</h2>
                    </div>

                    <p>@Model.AboutContent</p>
                </section>

                <!-- LATEST ARTICLES -->
                <section id="latest-articles" class="content-card">
                    <div class="section-heading section-heading-row">
                        <div>
                            <span>Yayınlar</span>
                            <h2>Son Yayınlanan Makaleler</h2>
                        </div>

                        <a asp-controller="Issues" asp-action="Published" class="small-link">Tümünü Gör</a>
                    </div>

                    <div class="article-list">
                        @if (Model.LatestArticles != null && Model.LatestArticles.Any())
                        {
                            foreach (var article in Model.LatestArticles)
                            {
                                <article class="article-item">
                                    <div class="article-meta">
                                        <span>Makale</span>
                                    </div>

                                    <h3>@article.Title</h3>

                                    @if (!string.IsNullOrWhiteSpace(article.Authors))
                                    {
                                        <div class="article-author">
                                            @article.Authors
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(article.Abstract))
                                    {
                                        <p>
                                            @(article.Abstract.Length > 260
                                                ? article.Abstract.Substring(0, 260) + "..."
                                                : article.Abstract)
                                        </p>
                                    }
                                </article>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                Henüz yayımlanmış makale bulunmamaktadır.
                            </div>
                        }
                    </div>
                </section>

                <!-- STATS -->
                <section class="stats-grid">
                    <div class="stat-card">
                        <strong>@Model.TotalArticles</strong>
                        <span>Yayınlanan Makale</span>
                    </div>

                    <div class="stat-card">
                        <strong>@Model.TotalReviewers</strong>
                        <span>Hakem</span>
                    </div>

                    <div class="stat-card">
                        <strong>@Model.TotalIssues</strong>
                        <span>Sayı</span>
                    </div>

                    <div class="stat-card">
                        <strong>@(Model.Indexes == null ? 0 : Model.Indexes.Count())</strong>
                        <span>İndeks</span>
                    </div>
                </section>

            </div>

            <!-- RIGHT SIDEBAR -->
            <aside class="main-right">

                <!-- SUBMISSION CARD -->
                <section class="submit-card">
                    <h2>Makale Gönderimi</h2>
                    <p>
                        Dergimize makale göndermek için sisteme giriş yaparak başvuru sürecinizi başlatabilirsiniz.
                    </p>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Submission" asp-action="YeniMakale">Makale Gönder</a>
                    }
                    else
                    {
                        <a href="/Identity/Account/Login">Giriş Yap ve Makale Gönder</a>
                    }
                </section>

                <!-- ANNOUNCEMENTS -->
                <section id="announcements" class="side-card">
                    <div class="side-title">
                        <h3>Duyurular</h3>
                    </div>

                    <div class="announcement-list">
                        @if (Model.Announcements != null && Model.Announcements.Any())
                        {
                            foreach (var ann in Model.Announcements)
                            {
                                <div class="announcement-item">
                                    <strong>@ann.Title</strong>

                                    @if (!string.IsNullOrWhiteSpace(ann.Content))
                                    {
                                        <span>@ann.Content</span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                Duyuru bulunmamaktadır.
                            </div>
                        }
                    </div>
                </section>

                <!-- INDEXES -->
                <section id="indexes" class="side-card">
                    <div class="side-title">
                        <h3>İndeksler</h3>
                    </div>

                    @if (Model.Indexes != null && Model.Indexes.Any())
                    {
                        <div class="index-list">
                            @foreach (var index in Model.Indexes)
                            {
                                if (!string.IsNullOrWhiteSpace(index.Url))
                                {
                                    <a href="@index.Url" target="_blank" class="index-link">
                                        @if (!string.IsNullOrWhiteSpace(index.LogoPath))
                                        {
                                            <img src="@index.LogoPath" alt="@index.Name" />
                                        }
                                        else
                                        {
                                            <span>@index.Name</span>
                                        }
                                    </a>
                                }
                                else
                                {
                                    <span>
                                        @if (!string.IsNullOrWhiteSpace(index.LogoPath))
                                        {
                                            <img src="@index.LogoPath" alt="@index.Name" />
                                        }
                                        else
                                        {
                                            @index.Name
                                        }
                                    </span>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            İndeks bilgisi henüz eklenmemiştir.
                        </div>
                    }
                </section>

                <!-- QUICK LINKS -->
                <section class="side-card">
                    <div class="side-title">
                        <h3>Hızlı Bağlantılar</h3>
                    </div>

                    <div class="quick-links">
                        <a href="#about">Dergi Hakkında</a>
                        <a asp-controller="Issues" asp-action="Published">Yayınlanan Sayılar</a>
                        <a href="#latest-articles">Son Makaleler</a>
                        <a href="#announcements">Duyurular</a>
                        <a href="#contact">İletişim</a>
                    </div>
                </section>

            </aside>

        </div>
    </section>

    <!-- FOOTER -->
    <footer id="contact" class="front-footer">
        <div class="front-container footer-grid">
            <div>
                <h3>@Model.JournalTitle</h3>
                <p>@Model.FooterText</p>
            </div>

            <div>
                <h4>Bağlantılar</h4>
                <a href="#about">Dergi Hakkında</a>
                <a asp-controller="Issues" asp-action="Published">Yayınlanan Sayılar</a>
                <a asp-controller="Submission" asp-action="YeniMakale">Makale Gönder</a>
            </div>

            <div>
                <h4>İletişim</h4>

                @if (!string.IsNullOrWhiteSpace(Model.ContactEmail))
                {
                    <p>E-posta: @Model.ContactEmail</p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
                {
                    <p>Telefon: @Model.ContactPhone</p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Address))
                {
                    <p>Adres: @Model.Address</p>
                }
            </div>
        </div>

        <div class="footer-bottom">
            © @DateTime.Now.Year @Model.JournalTitle. Tüm hakları saklıdır.
        </div>
    </footer>

    @if (Model.Announcements != null && Model.Announcements.Any(x => x.ShowAsPopup))
    {
        var popup = Model.Announcements.First(x => x.ShowAsPopup);

        <div id="announcementModal" class="announcement-modal">
            <div class="announcement-modal-box">
                <button type="button"
                        onclick="closePopup()"
                        class="announcement-modal-close">
                    ✖
                </button>

                <h4>@popup.Title</h4>
                <p>@popup.Content</p>
            </div>
        </div>

        <script>
                document.body.style.overflow = "hidden";

                function closePopup() {
                    const modal = document.getElementById("announcementModal");
                    if (modal) modal.style.display = "none";
                    document.body.style.overflow = "auto";
                }
        </script>
    }

</div>