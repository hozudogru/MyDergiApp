@model MyDergiApp.ViewModels.HomePageViewModel
@{
    Layout = null;
    ViewData["Title"] = "Ana Sayfa";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.JournalTitle</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/frontpage.css" asp-append-version="true" />
    <style>
            :root {
                --theme-primary: @Model.PrimaryColor;
                --theme-secondary: @Model.SecondaryColor;
                --theme-header-bg: @Model.HeaderBgColor;
                --theme-nav-bg: @Model.NavBgColor;
                --theme-body-bg: @Model.BodyBgColor;
                --theme-text: @Model.TextColor;
            }

            body {
                background: var(--theme-body-bg);
                color: var(--theme-text);
            }

            .journal-header {
                background: var(--theme-header-bg);
            }

            .journal-nav {
                background: var(--theme-nav-bg);
            }

            .journal-title,
            .section-title,
            .article-item h5 {
                color: var(--theme-primary);
            }

            .btn-primary {
                background-color: var(--theme-primary);
                border-color: var(--theme-primary);
            }

            .btn-outline-primary {
                color: var(--theme-primary);
                border-color: var(--theme-primary);
            }

                .btn-outline-primary:hover {
                    background-color: var(--theme-primary);
                    border-color: var(--theme-primary);
                }

            .btn-success {
                background-color: var(--theme-secondary);
                border-color: var(--theme-secondary);
            }

            .journal-nav a {
                color: var(--theme-primary);
            }

            .hero-label {
                color: var(--theme-secondary);
            }

            .theme-modern .hero-box,
            .theme-modern .content-card,
            .theme-modern .sidebar-card,
            .theme-modern .stats-card {
                border-radius: 28px;
                box-shadow: 0 20px 50px rgba(15, 23, 42, .10);
            }

            .theme-darkblue .journal-header {
                background: var(--theme-header-bg);
                color: #ffffff;
            }

            .theme-darkblue .journal-title,
            .theme-darkblue .journal-subtitle,
            .theme-darkblue .header-issue-badge {
                color: #ffffff;
            }

            .theme-darkblue .journal-topbar {
                background: #061a38;
            }

            .theme-green .hero-box,
            .theme-green .content-card,
            .theme-green .sidebar-card {
                border-left: 5px solid var(--theme-primary);
            }

            .theme-burgundy .hero-box,
            .theme-burgundy .content-card,
            .theme-burgundy .sidebar-card {
                border-top: 5px solid var(--theme-primary);
            }

            .theme-burgundy .journal-topbar {
                background: #450a0a;
            }

            .theme-classic .hero-box {
                border-radius: 18px;
            }
    </style>
</head>
<body class="theme-@Model.ThemeName">

    <div class="journal-topbar">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.PrintIssn))
                {
                    <span>ISSN (Basılı): @Model.PrintIssn</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.OnlineIssn))
                {
                    <span class="ms-3">ISSN (Çevrim içi): @Model.OnlineIssn</span>
                }
            </div>

            <div>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index">Panel</a>
                    }
                    else if (User.IsInRole("ChiefEditor"))
                    {
                        <a asp-controller="Submission" asp-action="OnKontrolListesi">Panel</a>
                    }
                    else if (User.IsInRole("Editor"))
                    {
                        <a asp-controller="Submission" asp-action="EditorDashboard">Panel</a>
                    }
                    else if (User.IsInRole("Reviewer"))
                    {
                        <a asp-controller="Submission" asp-action="MyReviews">Panel</a>
                    }
                    else if (User.IsInRole("Author"))
                    {
                        <a asp-controller="Submission" asp-action="Makalelerim">Panel</a>
                    }

                    <span class="mx-2">|</span>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                          method="post"
                          style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                style="border:none; background:none; padding:0; color:inherit; text-decoration:underline; cursor:pointer;">
                            Çıkış
                        </button>
                    </form>
                }
                else
                {
                    <a href="/Identity/Account/Register">Kayıt Ol</a>
                    <span class="mx-2">|</span>
                    <a href="/Identity/Account/Login">Giriş Yap</a>
                }
            </div>
        </div>
    </div>

    <header class="journal-header dynamic-header"
            style="@(string.IsNullOrWhiteSpace(Model.HeaderBackgroundImagePath)
                        ? ""
                        : $"background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)), url('{Model.HeaderBackgroundImagePath}');")">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-4">
            <div class="d-flex align-items-center gap-4">
                @if (Model.ShowHeaderLogo && !string.IsNullOrWhiteSpace(Model.HeaderLogoPath))
                {
                    <img src="@Model.HeaderLogoPath"
                         alt="Logo"
                         class="journal-logo dynamic-header-logo" />
                }

                <div>
                    <h1 class="journal-title">
                        @(string.IsNullOrWhiteSpace(Model.HeaderTitle) ? Model.JournalTitle : Model.HeaderTitle)
                    </h1>

                    <div class="journal-subtitle">
                        @(string.IsNullOrWhiteSpace(Model.HeaderSubtitle) ? Model.JournalSubtitle : Model.HeaderSubtitle)
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.HeaderRightText))
            {
                <div class="header-issue-badge">
                    @Model.HeaderRightText
                </div>
            }
        </div>
    </header>

    <nav class="journal-nav">
        <div class="journal-nav-inner">
            <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
            <a href="#about">Dergi Hakkında</a>
            <a asp-controller="Issues" asp-action="Published">Yayınlanan Sayılar</a>
            <a href="#latest-articles">Son Makaleler</a>
            <a href="#announcements">Duyurular</a>
            <a href="#indexes">İndeksler</a>
            <a href="#contact">İletişim</a>
            <a asp-controller="Submission" asp-action="YeniMakale">Makale Gönder</a>
        </div>
    </nav>

    <section class="hero-section">
        <div class="container">
            <div class="row g-4 align-items-stretch">

                <div class="col-lg-8">
                    @if (Model.CurrentIssue != null)
                    {
                        <div class="content-card mb-4">
                            <div class="section-title">Güncel Sayı</div>
                            <div class="current-issue-box">
                                <div class="issue-cover">
                                    <img src="@(string.IsNullOrWhiteSpace(Model.CurrentIssue.CoverImagePath) ? "https://via.placeholder.com/180x250?text=Sayi+Kapagi" : Model.CurrentIssue.CoverImagePath)"
                                         alt="Güncel Sayı Kapağı" />
                                </div>

                                <div class="issue-details">
                                    <h4>@Model.CurrentIssue.Title</h4>
                                    <p><strong>Cilt:</strong> @Model.CurrentIssue.Volume</p>
                                    <p><strong>Sayı:</strong> @Model.CurrentIssue.Number</p>
                                    <p><strong>Yıl:</strong> @Model.CurrentIssue.Year</p>

                                    @if (Model.CurrentIssue.PublishedDate.HasValue)
                                    {
                                        <p><strong>Yayın Tarihi:</strong> @Model.CurrentIssue.PublishedDate.Value.ToString("dd.MM.yyyy")</p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.CurrentIssue.Description))
                                    {
                                        <p>@Model.CurrentIssue.Description</p>
                                    }

                                    <div class="mt-3">
                                        <a asp-controller="Issues"
                                           asp-action="Published"
                                           class="btn btn-primary btn-sm me-2">
                                            Sayıları Görüntüle
                                        </a>

                                        <a asp-controller="Issues"
                                           asp-action="Published"
                                           class="btn btn-outline-primary btn-sm">
                                            Tüm Sayılar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ShowBanner)
{
    <div class="hero-box mb-4 dynamic-banner">
        <div class="row g-4 align-items-center">
            <div class="col-lg-@(string.IsNullOrWhiteSpace(Model.BannerImagePath) ? "12" : "7")">
                @if (!string.IsNullOrWhiteSpace(Model.BannerLabel))
                {
                    <span class="hero-label">@Model.BannerLabel</span>
                }

                <h2>@(string.IsNullOrWhiteSpace(Model.BannerTitle) ? Model.HeroTitle : Model.BannerTitle)</h2>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.BannerDescription) ? Model.HeroDescription : Model.BannerDescription)
                </p>

                <div class="hero-actions">
                    @if (!string.IsNullOrWhiteSpace(Model.BannerPrimaryButtonText))
                    {
                        <a href="@(string.IsNullOrWhiteSpace(Model.BannerPrimaryButtonUrl) ? "/Submission/YeniMakale" : Model.BannerPrimaryButtonUrl)"
                           class="btn btn-primary btn-lg me-2">
                            @Model.BannerPrimaryButtonText
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.BannerSecondaryButtonText))
                    {
                        <a href="@(string.IsNullOrWhiteSpace(Model.BannerSecondaryButtonUrl) ? "/Issues/Published" : Model.BannerSecondaryButtonUrl)"
                           class="btn btn-outline-primary btn-lg">
                            @Model.BannerSecondaryButtonText
                        </a>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.BannerImagePath))
            {
                <div class="col-lg-5 text-center">
                    <img src="@Model.BannerImagePath"
                         alt="Banner"
                         class="img-fluid dynamic-banner-img" />
                </div>
            }
        </div>
    </div>
}
                        <span class="hero-label">Hakemli • Açık Erişim • Akademik Yayıncılık</span>
                        <h2>@Model.HeroTitle</h2>
                        <p>@Model.HeroDescription</p>

                        <div class="hero-actions">
                            <a asp-controller="Submission" asp-action="YeniMakale" class="btn btn-primary btn-lg me-2">
                                Makale Gönder
                            </a>
                            <a asp-controller="Issues" asp-action="Published" class="btn btn-outline-primary btn-lg">
                                Makaleleri İncele
                            </a>
                        </div>
                    </div>

                    <div id="about" class="content-card mb-4">
                        <div class="section-title">@Model.AboutTitle</div>
                        <p>@Model.AboutContent</p>
                    </div>

                    <div id="latest-articles" class="content-card">
                        <div class="section-title">Son Yayınlanan Makaleler</div>

                        @if (Model.LatestArticles.Any())
                        {
                            @foreach (var article in Model.LatestArticles)
                            {
                                <div class="article-item">
                                    <h5>@article.Title</h5>
                                    <div class="article-meta">@article.Authors</div>

                                    @if (!string.IsNullOrWhiteSpace(article.Abstract))
                                    {
                                        <p>@(article.Abstract.Length > 220 ? article.Abstract.Substring(0, 220) + "..." : article.Abstract)</p>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p>Yayınlanmış makale bulunmamaktadır.</p>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="stats-card mb-4">
                        <div class="stats-grid">
                            <div class="stat-item">
                                <h3>@Model.TotalArticles</h3>
                                <p>Makale</p>
                            </div>
                            <div class="stat-item">
                                <h3>@Model.TotalIssues</h3>
                                <p>Sayı</p>
                            </div>
                            <div class="stat-item">
                                <h3>@Model.TotalReviewers</h3>
                                <p>Hakem</p>
                            </div>
                            <div class="stat-item">
                                <h3>@Model.TotalAuthors</h3>
                                <p>Yazar</p>
                            </div>
                        </div>
                    </div>

                    <div id="announcements" class="sidebar-card mb-4">
                        <div class="section-title">Duyurular</div>

                        @if (Model.Announcements.Any())
                        {
                            @foreach (var ann in Model.Announcements)
                            {
                                <div class="mb-3">
                                    <strong>@ann.Title</strong>
                                    <div style="font-size: 0.9rem; color:#6b7c8f;">
                                        @ann.Content
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p>Duyuru bulunmamaktadır.</p>
                        }
                    </div>

                    <div class="sidebar-card mb-4 text-center">
                        <div class="section-title">Makale Gönderimi</div>
                        <p>Makalenizi çevrim içi dergi yönetim sistemi üzerinden gönderebilirsiniz.</p>
                        <a asp-controller="Submission" asp-action="YeniMakale" class="btn btn-success w-100">
                            Makale Gönder
                        </a>
                    </div>

                    <div id="indexes" class="sidebar-card mb-4">
                        <div class="section-title">İndeksler</div>

                        @if (Model.Indexes.Any())
                        {
                            <div class="index-list">
                                @foreach (var index in Model.Indexes)
                                {
                                    <a href="@index.Url" target="_blank" class="index-item">
                                        @if (!string.IsNullOrWhiteSpace(index.LogoPath))
                                        {
                                            <img src="@index.LogoPath" alt="@index.Name" />
                                        }
                                        else
                                        {
                                            <span>@index.Name</span>
                                        }
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="mb-0">İndeks bilgisi henüz eklenmemiştir.</p>
                        }
                    </div>

                    <div class="sidebar-card">
                        <div class="section-title">Hızlı Bağlantılar</div>
                        <ul class="footer-links">
                            <li><a href="#about">Dergi Hakkında</a></li>
                            <li><a asp-controller="Issues" asp-action="Published">Yayınlanan Sayılar</a></li>
                            <li><a asp-controller="Submission" asp-action="YeniMakale">Makale Gönder</a></li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <footer id="contact" class="journal-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>@Model.JournalTitle</h5>
                    <p>@Model.FooterText</p>
                </div>

                <div class="col-md-4">
                    <h5>İletişim</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.ContactEmail))
                    {
                        <p>E-posta: @Model.ContactEmail</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
                    {
                        <p>Telefon: @Model.ContactPhone</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Address))
                    {
                        <p>Adres: @Model.Address</p>
                    }
                </div>

                <div class="col-md-4">
                    <h5>Hızlı Bağlantılar</h5>
                    <ul class="footer-links">
                        <li><a href="#about">Dergi Hakkında</a></li>
                        <li><a asp-controller="Issues" asp-action="Published">Yayınlanan Sayılar</a></li>
                        <li><a asp-controller="Submission" asp-action="YeniMakale">Makale Gönder</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    @if (Model.Announcements.Any(x => x.ShowAsPopup))
    {
        var popup = Model.Announcements.First(x => x.ShowAsPopup);

        <div id="announcementModal"
             style="position:fixed; inset:0; width:100vw; height:100vh; background:rgba(0,0,0,.6); display:flex; align-items:center; justify-content:center; z-index:99999;">

            <div style="position:relative; background:#fff; padding:30px; border-radius:12px; max-width:500px; width:90%; text-align:center; box-shadow:0 20px 50px rgba(0,0,0,.2);">

                <button type="button"
                        onclick="closePopup()"
                        style="position:absolute; top:10px; right:15px; border:none; background:none; font-size:20px; cursor:pointer;">
                    ✖
                </button>

                <h4>@popup.Title</h4>
                <p>@popup.Content</p>
            </div>
        </div>

        <script>
                document.body.style.overflow = "hidden";

                function closePopup() {
                    const modal = document.getElementById("announcementModal");
                    if (modal) modal.style.display = "none";
                    document.body.style.overflow = "auto";
                }
        </script>
    }
</body>
</html>
