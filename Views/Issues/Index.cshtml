@model IEnumerable<MyDergiApp.Models.Issue>

@{
    ViewData["Title"] = "Sayılar";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <h3 class="mb-0 fw-bold">Sayılar</h3>

        <a asp-action="Create" class="btn btn-primary">
            Yeni Sayı Oluştur
        </a>
    </div>

    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Yıl</th>
                        <th>Cilt</th>
                        <th>Sayı</th>
                        <th>Başlık</th>
                        <th>Makale</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var issue in Model)
                    {
                        <tr>
                            <td>@issue.Year</td>
                            <td>@issue.Volume</td>
                            <td>@issue.Number</td>
                            <td>@(string.IsNullOrWhiteSpace(issue.Title) ? "-" : issue.Title)</td>
                            <td>@(issue.Articles?.Count ?? 0)</td>
                            <td>
                                @if (issue.IsPublished)
                                {
                                    <span class="badge bg-success">Yayında</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Taslak</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="ManageArticles"
                                   asp-route-id="@issue.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Makaleler
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@issue.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Düzenle
                                </a>

                                <form asp-action="TogglePublish"
                                      asp-route-id="@issue.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(issue.IsPublished ? "btn-outline-warning" : "btn-outline-success")">
                                        @(issue.IsPublished ? "Yayından Kaldır" : "Yayınla")
                                    </button>
                                </form>

                                <form asp-action="Delete"
                                      asp-route-id="@issue.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Bu sayı silinsin mi?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
