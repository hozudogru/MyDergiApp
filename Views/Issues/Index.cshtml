@model IEnumerable<MyDergiApp.Models.Issue>

@{
    ViewData["Title"] = "Sayılar";

    var upcomingIssues = Model.Where(x => !x.IsPublished).ToList();
    var publishedIssues = Model.Where(x => x.IsPublished).ToList();
}

<div class="issue-admin-page">

    <div class="issue-admin-header">
        <div>
            <h1>Sayılar</h1>
            <p>Dergi sayılarını oluşturun, düzenleyin ve yayımlayın.</p>
        </div>

        <a asp-action="Create" class="issue-primary-btn">
            Yeni Sayı Oluştur
        </a>
    </div>

    

    <div class="issue-tabs">
        <button type="button" class="issue-tab active" onclick="openIssueTab(event, 'futureIssues')">
            Gelecek Sayılar
        </button>

        <button type="button" class="issue-tab" onclick="openIssueTab(event, 'pastIssues')">
            Önceki Sayılar
        </button>
    </div>

    <div id="futureIssues" class="issue-tab-panel active">
        <div class="issue-panel-card">
            <div class="issue-panel-title">
                <h2>Gelecek Sayılar</h2>
            </div>

            @if (upcomingIssues.Any())
            {
                foreach (var issue in upcomingIssues)
                {
                    <div class="issue-row">
                        <div class="issue-row-main">
                            <a asp-action="ManageArticles"
                               asp-route-id="@issue.Id"
                               class="issue-title-link">
                                Cilt @issue.Volume Sayı @issue.Number (@issue.Year)
                            </a>

                            <div class="issue-row-actions">
                                <a asp-action="ManageArticles" asp-route-id="@issue.Id">Düzenle</a>

                                <a asp-action="ManageArticles" asp-route-id="@issue.Id">
                                    Sayı Yönetimi
                                </a>

                                <a asp-action="Details" asp-route-id="@issue.Id" target="_blank">
                                    Önizleme
                                </a>

                                <form asp-action="TogglePublish"
                                      asp-route-id="@issue.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            onclick="return confirm('Bu sayıyı yayımlamak istiyor musunuz?');">
                                        Sayıyı Yayınla
                                    </button>
                                </form>

                                <form asp-action="Delete"
                                      asp-route-id="@issue.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Bu sayı silinsin mi?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="danger-link">
                                        Sil
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="issue-row-count">
                            <strong>@(issue.Articles?.Count ?? 0)</strong>
                            <span>Öğe</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="issue-empty">
                    Gelecek sayı bulunmamaktadır.
                </div>
            }
        </div>
    </div>

    <div id="pastIssues" class="issue-tab-panel">
        <div class="issue-panel-card">
            <div class="issue-panel-title">
                <h2>Önceki Sayılar</h2>
            </div>

            @if (publishedIssues.Any())
            {
                foreach (var issue in publishedIssues)
                {
                    <div class="issue-row">
                        <div class="issue-row-main">
                            <a asp-action="ManageArticles"
                               asp-route-id="@issue.Id"
                               class="issue-title-link">
                                Cilt @issue.Volume Sayı @issue.Number (@issue.Year)
                            </a>

                            <div class="issue-row-actions">
                                <a asp-action="Edit" asp-route-id="@issue.Id">Düzenle</a>

                                <a asp-action="ManageArticles" asp-route-id="@issue.Id">
                                    Sayı Yönetimi
                                </a>

                                <a asp-action="Details" asp-route-id="@issue.Id" target="_blank">
                                    Görüntüle
                                </a>

                                <form asp-action="TogglePublish"
                                      asp-route-id="@issue.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            onclick="return confirm('@(issue.IsPublished ? "Bu sayıyı yayından kaldırmak istiyor musunuz?" : "Bu sayıyı yayımlamak istiyor musunuz?")');">
                                        @(issue.IsPublished ? "Yayından Kaldır" : "Sayıyı Yayınla")
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="issue-row-count">
                            <strong>@(issue.Articles?.Count ?? 0)</strong>
                            <span>Öğe</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="issue-empty">
                    Önceki sayı bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>

<script>
    function openIssueTab(event, panelId) {
        document.querySelectorAll(".issue-tab").forEach(x => x.classList.remove("active"));
        document.querySelectorAll(".issue-tab-panel").forEach(x => x.classList.remove("active"));

        event.currentTarget.classList.add("active");
        document.getElementById(panelId).classList.add("active");
    }
</script>