@model MyDergiApp.Models.Submission
@using MyDergiApp.Models

@{
    ViewData["Title"] = "Editör Kararı";

    int totalReviewerCount = ViewBag.TotalReviewerCount ?? 0;
    int completedReviewerCount = ViewBag.CompletedReviewerCount ?? 0;
    bool allReviewsCompleted = ViewBag.AllReviewsCompleted == true;
    bool hasConflictingReviews = ViewBag.HasConflictingReviews == true;
    bool canAssignAdditionalReviewer = ViewBag.CanAssignAdditionalReviewer == true;

    var allAssignments = ViewBag.RoundAssignments as List<MyDergiApp.Models.SubmissionReviewer>
                         ?? new List<MyDergiApp.Models.SubmissionReviewer>();

    var reviewers = ViewBag.Reviewers as List<MyDergiApp.Entities.AppUser>
                    ?? new List<MyDergiApp.Entities.AppUser>();

    var isFinalDecisionGiven =
    Model.Status == SubmissionStatus.KabulEdildi ||
    Model.Status == SubmissionStatus.Reddedildi ||
    Model.Status == SubmissionStatus.GeriCekildi;
}

<div class="editor-decision-page">

    <!-- ÜST BİLGİ -->
    <div class="submission-header mb-4">
        <div>
            <div class="submission-breadcrumb">
                <span>@Model.Id</span>
                <span>/</span>
                <strong>@(Model.Authors?.OrderBy(a => a.SortOrder).FirstOrDefault()?.FullName ?? "Yazar")</strong>
                <span>/</span>
                <span>@Model.Title</span>
            </div>

            <h2 class="fw-bold mt-3 mb-1">Editör Kararı</h2>

            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <div class="text-muted fs-6">@Model.Subtitle</div>
            }

            <div class="d-flex flex-wrap gap-3 small text-muted mt-3">
                <span><strong>Makale No:</strong> @Model.Id</span>

                <span>
                    <strong>Durum:</strong>
                    <span class="badge @StatusDisplayHelper.GetSubmissionStatusBadgeClass(Model.Status)">
                        @StatusDisplayHelper.GetSubmissionStatusText(Model.Status)
                    </span>
                </span>

                <span><strong>Tur:</strong> @Model.CurrentReviewRound. Tur</span>
                <span><strong>Oluşturulma:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
            </div>
        </div>

        <div>
            <a asp-controller="Submission"
               asp-action="EditorDashboard"
               class="btn btn-outline-secondary">
                Dashboard'a Dön
            </a>
        </div>
    </div>

    <!-- HAKEM TAMAMLANMA DURUMU -->
    <div class="alert @(canAssignAdditionalReviewer ? "alert-warning" : allReviewsCompleted ? "alert-success" : "alert-info") rounded-4 border-0 shadow-sm mb-4">
        <strong>@Model.CurrentReviewRound. Tur Hakem Durumu:</strong>
        @completedReviewerCount / @totalReviewerCount hakem değerlendirmesini tamamladı.

        @if (canAssignAdditionalReviewer)
        {
            <span class="ms-2 fw-semibold">
                Hakem kararları çelişkili görünüyor. Gerekirse ek / 3. hakem atanabilir.
            </span>
        }
        else if (hasConflictingReviews && allReviewsCompleted)
        {
            <span class="ms-2 fw-semibold">
                Hakem raporları tamamlandı. Çelişkili görüşler editör kararıyla sonuçlandırılabilir.
            </span>
        }
        else if (allReviewsCompleted)
        {
            <span class="ms-2 fw-semibold">
                Hakem raporları tamamlandı. Editör kararı verilebilir.
            </span>
        }
        else
        {
            <span class="ms-2">
                Hakem değerlendirmeleri bekleniyor.
            </span>
        }
    </div>
    @if (isFinalDecisionGiven)
    {
        <div class="alert alert-success rounded-4 border-0 shadow-sm mb-4">
            <strong>Bu makale için nihai editör kararı verilmiştir.</strong>
            Kabul, red veya revizyon kararı tekrar verilemez.
        </div>
    }

    <!-- SÜREÇ SEKMELERİ -->
    <div class="workflow-panel mb-4">
        <div class="workflow-main-tabs">
            <a asp-controller="Submission"
               asp-action="Detail"
               asp-route-id="@Model.Id"
               class="workflow-main-tab">
                Gönderi
            </a>

            <a href="#"
               class="workflow-main-tab active">
                Değerlendir
            </a>

            <a href="#"
               class="workflow-main-tab disabled-tab">
                Kopya Düzenleme
            </a>

            <a href="#"
               class="workflow-main-tab disabled-tab">
                Basım
            </a>
        </div>

        <div class="workflow-round-tabs">
            @for (int i = 1; i <= Model.CurrentReviewRound; i++)
            {
                <a href="#round-@i"
                   class="workflow-round-tab @(i == Model.CurrentReviewRound ? "active" : "")">
                    @i. Tur
                </a>
            }

            <a href="#"
               class="workflow-round-tab new-round disabled-tab">
                Yeni Değerlendirme Turu
            </a>
        </div>
    </div>

    <!-- ANA İÇERİK -->
    <div class="review-layout">

        <!-- SOL ANA KOLON -->
        <div class="review-main">

            <!-- TUR DURUMU -->
            <div class="round-status-box mb-4">
                <div class="round-status-title">
                    @Model.CurrentReviewRound. Tur Durumu
                </div>

                @if (Model.Status == SubmissionStatus.RevizyonYuklendi)
                {
                    <div>Yazar revizyon dosyasını yükledi. Yeni değerlendirme veya karar bekleniyor.</div>
                }
                else if (Model.Status == SubmissionStatus.HakemDegerlendirmesinde)
                {
                    <div>Hakem değerlendirmesi devam ediyor.</div>
                }
                else if (Model.Status == SubmissionStatus.HakemAtamasiBekliyor)
                {
                    <div>@Model.CurrentReviewRound. tur değerlendirme süreci başlatıldı. Hakem ataması bekleniyor.</div>
                }
                else if (Model.Status == SubmissionStatus.RevizyonIstendi)
                {
                    <div>Yazardan revizyon bekleniyor.</div>
                }
                else if (Model.Status == SubmissionStatus.KabulEdildi)
                {
                    <div>Gönderi kabul edildi.</div>
                }
                else if (Model.Status == SubmissionStatus.Reddedildi)
                {
                    <div>Gönderi reddedildi.</div>
                }
                else
                {
                    <div>Bu tur için işlem bekleniyor.</div>
                }
            </div>

            @if (allAssignments.Any(sr => sr.ReviewRound == Model.CurrentReviewRound) &&
                 (Model.Reviews == null || !Model.Reviews.Any(r => r.ReviewRound == Model.CurrentReviewRound && !r.IsDraft)))
            {
                <div class="alert alert-info border-0 rounded-4 mb-4">
                    @Model.CurrentReviewRound. tur için hakem ataması yapıldı.
                    Henüz bu tura ait nihai hakem raporu gönderilmedi.
                </div>
            }

            <!-- DEĞERLENDİRME TURLARI -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                    <h4 class="fw-bold mb-3">Değerlendirme Turları</h4>
                </div>

                <div class="card-body p-4">
                    @for (int round = 1; round <= Model.CurrentReviewRound; round++)
                    {
                        var roundFiles = Model.Files?
                            .Where(f => (f.ReviewRound <= 0 ? 1 : f.ReviewRound) == round)
                            .OrderByDescending(f => f.UploadedAt)
                            .ToList() ?? new List<MyDergiApp.Models.SubmissionFile>();

                        var roundReviewers = allAssignments
                            .Where(sr => (sr.ReviewRound <= 0 ? 1 : sr.ReviewRound) == round)
                            .OrderByDescending(sr => sr.AssignedAt)
                            .ToList();

                        var roundReviews = Model.Reviews?
                            .Where(r => (r.ReviewRound <= 0 ? 1 : r.ReviewRound) == round && !r.IsDraft)
                            .OrderByDescending(r => r.SubmittedAt ?? r.UpdatedAt ?? r.CreatedAt)
                            .ToList() ?? new List<MyDergiApp.Models.Review>();

                        var isCurrentRound = round == Model.CurrentReviewRound;
                        var collapseId = $"roundCollapse{round}";

                        <div id="round-@round" class="round-card mb-3 @(isCurrentRound ? "current-round" : "")">
                            <button class="round-card-header"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="@(isCurrentRound ? "true" : "false")"
                                    aria-controls="@collapseId">

                                <div>
                                    <div class="round-title">
                                        @round. Tur

                                        @if (isCurrentRound)
                                        {
                                            <span class="badge bg-primary ms-2">Aktif Tur</span>
                                        }
                                    </div>

                                    <div class="round-summary">
                                        Dosya: @roundFiles.Count |
                                        Hakem: @roundReviewers.Count |
                                        Rapor: @roundReviews.Count
                                    </div>
                                </div>

                                <span class="round-toggle-text">
                                    Detayları Göster / Gizle
                                </span>
                            </button>

                            <div id="@collapseId"
                                 class="collapse @(isCurrentRound ? "show" : "")">

                                <div class="round-card-body">

                                    <div class="round-status-mini mb-4">
                                        <strong>@round. Tur Durumu:</strong>

                                        @if (isCurrentRound && Model.Status == SubmissionStatus.RevizyonYuklendi)
                                        {
                                            <span>Yazar revizyon dosyasını yükledi. Yeni değerlendirme veya karar bekleniyor.</span>
                                        }
                                        else if (isCurrentRound && Model.Status == SubmissionStatus.HakemAtamasiBekliyor)
                                        {
                                            <span>Hakem ataması bekleniyor.</span>
                                        }
                                        else if (isCurrentRound && Model.Status == SubmissionStatus.HakemDegerlendirmesinde)
                                        {
                                            <span>Hakem değerlendirmesi devam ediyor.</span>
                                        }
                                        else if (isCurrentRound && Model.Status == SubmissionStatus.RevizyonIstendi)
                                        {
                                            <span>Yazardan revizyon bekleniyor.</span>
                                        }
                                        else if (roundReviews.Any())
                                        {
                                            <span>Bu turda hakem raporu bulunmaktadır.</span>
                                        }
                                        else
                                        {
                                            <span>Bu tur için kayıtlı rapor bulunmuyor.</span>
                                        }
                                    </div>

                                    <!-- TUR DOSYALARI -->
                                    <div class="section-subtitle">Tur Dosyaları</div>

                                    @if (roundFiles.Any())
                                    {
                                        <div class="table-responsive mb-4">
                                            <table class="table table-sm align-middle">
                                                <thead>
                                                    <tr>
                                                        <th>#</th>
                                                        <th>Dosya</th>
                                                        <th>Dosya Türü</th>
                                                        <th>Yükleme Tarihi</th>
                                                        <th class="text-end">İşlem</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var file in roundFiles)
                                                    {
                                                        <tr>
                                                            <td>@file.Id</td>
                                                            <td>
                                                                <strong>@file.OriginalFileName</strong>

                                                                <span class="badge @StatusDisplayHelper.GetFileTypeBadgeClass(file.FileType) ms-2">
                                                                    @StatusDisplayHelper.GetFileTypeText(file.FileType)
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <span class="badge @StatusDisplayHelper.GetFileTypeBadgeClass(file.FileType)">
                                                                    @StatusDisplayHelper.GetFileTypeText(file.FileType)
                                                                </span>
                                                            </td>
                                                            <td>@file.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                                            <td class="text-end">
                                                                <a asp-controller="Submission"
                                                                   asp-action="DownloadFile"
                                                                   asp-route-id="@file.Id"
                                                                   target="_blank"
                                                                   class="btn btn-sm btn-outline-primary">
                                                                    Aç / İndir
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-light border mb-4">
                                            Bu tura ait dosya bulunmuyor.
                                        </div>
                                    }

                                    <!-- HAKEM ATAMALARI -->
                                    <div class="section-subtitle">Hakem Atamaları</div>

                                    @if (roundReviewers.Any())
                                    {
                                        <div class="table-responsive mb-4">
                                            <table class="table table-sm align-middle">
                                                <thead>
                                                    <tr>
                                                        <th>Hakem</th>
                                                        <th>Durum</th>
                                                        <th>Atama Tarihi</th>
                                                        <th>Son Tarih</th>
                                                        <th>Tamamlanma</th>
                                                        <th class="text-end">İşlem</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var sr in roundReviewers)
                                                    {
                                                        var isOverdue = sr.DueDate.HasValue
                                                            && sr.DueDate.Value < DateTime.UtcNow
                                                            && sr.Status != ReviewerAssignmentStatus.Completed
                                                            && sr.Status != ReviewerAssignmentStatus.Cancelled
                                                            && sr.Status != ReviewerAssignmentStatus.Declined;

                                                        <tr>
                                                            <td>
                                                                @(sr.Reviewer?.FullName ?? sr.Reviewer?.UserName ?? sr.Reviewer?.Email ?? "-")

                                                                @if (sr.ReminderCount > 0)
                                                                {
                                                                    <div class="small text-muted">
                                                                        Hatırlatma: @sr.ReminderCount kez
                                                                    </div>
                                                                }
                                                            </td>

                                                            <td>
                                                                @if (isOverdue)
                                                                {
                                                                    <span class="badge bg-danger">
                                                                        Gecikti
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge @StatusDisplayHelper.GetReviewerAssignmentBadgeClass(sr.Status)">
                                                                        @StatusDisplayHelper.GetReviewerAssignmentStatusText(sr.Status)
                                                                    </span>
                                                                }
                                                            </td>

                                                            <td>@sr.AssignedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>

                                                            <td>
                                                                @(sr.DueDate.HasValue
                                                                    ? sr.DueDate.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                                                    : "-")
                                                            </td>

                                                            <td>
                                                                @(sr.CompletedAt.HasValue
                                                                    ? sr.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                                    : "-")
                                                            </td>

                                                            <td class="text-end">
                                                                @if (sr.Status != ReviewerAssignmentStatus.Completed &&
                                                                     sr.Status != ReviewerAssignmentStatus.Cancelled &&
                                                                     sr.Status != ReviewerAssignmentStatus.Declined)
                                                                {
                                                                    <form asp-controller="Submission"
                                                                          asp-action="SendReviewerReminder"
                                                                          method="post"
                                                                          class="d-inline">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="assignmentId" value="@sr.Id" />

                                                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                                                            Hatırlat
                                                                        </button>
                                                                    </form>

                                                                    <form asp-controller="Submission"
                                                                          asp-action="CancelReviewerAssignment"
                                                                          method="post"
                                                                          class="d-inline ms-1">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="assignmentId" value="@sr.Id" />
                                                                        <input type="hidden" name="reason" value="Editör tarafından yeniden atama için iptal edildi." />

                                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                            İptal Et
                                                                        </button>
                                                                    </form>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted small">İşlem yok</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-light border mb-4">
                                            Bu tur için hakem ataması yapılmamış.
                                        </div>
                                    }

                                    <!-- HAKEM RAPORLARI -->
                                    <div class="section-subtitle">Hakem Raporları</div>

                                    @if (roundReviews.Any())
                                    {
                                        <div class="accordion" id="reviewAccordionRound@round">
                                            @foreach (var review in roundReviews)
                                            {
                                                var reviewCollapseId = $"reviewCollapse_{round}_{review.Id}";

                                                <div class="accordion-item review-accordion-item">
                                                    <h2 class="accordion-header">
                                                        <button class="accordion-button collapsed"
                                                                type="button"
                                                                data-bs-toggle="collapse"
                                                                data-bs-target="#@reviewCollapseId">
                                                            <div class="review-accordion-title">
                                                                <strong>
                                                                    @(review.Reviewer?.FullName ?? review.Reviewer?.UserName ?? "Hakem")
                                                                </strong>

                                                                <span class="badge rounded-pill text-bg-light border ms-2">
                                                                    @(
                                                                        string.IsNullOrWhiteSpace(review.Decision)
                                                                            ? "Karar Yok"
                                                                            : review.Decision == "Accept"
                                                                                ? "Kabul"
                                                                                : review.Decision == "Minor Revision"
                                                                                    ? "Küçük Revizyon"
                                                                                    : review.Decision == "Major Revision"
                                                                                        ? "Büyük Revizyon"
                                                                                        : review.Decision == "Reject"
                                                                                            ? "Ret"
                                                                                            : review.Decision
                                                                    )
                                                                </span>

                                                                <span class="text-muted small ms-2">
                                                                    @(review.SubmittedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")
                                                                </span>
                                                            </div>
                                                        </button>
                                                    </h2>

                                                    <div id="@reviewCollapseId"
                                                         class="accordion-collapse collapse"
                                                         data-bs-parent="#reviewAccordionRound@round">
                                                        <div class="accordion-body">

                                                            <div class="row g-3 mb-3">
                                                                @if (review.OverallScore.HasValue)
                                                                {
                                                                    <div class="col-md-3">
                                                                        <div class="metric-box">
                                                                            <div class="metric-title">Genel Puan</div>
                                                                            <div class="metric-value">@review.OverallScore</div>
                                                                        </div>
                                                                    </div>
                                                                }

                                                                @if (!string.IsNullOrWhiteSpace(review.Decision))
                                                                {
                                                                    <div class="col-md-3">
                                                                        <div class="metric-box">
                                                                            <div class="metric-title">Hakem Kararı</div>
                                                                            <div class="metric-value small-value">
                                                                                @(
                                                                                    review.Decision == "Accept"
                                                                                        ? "Kabul"
                                                                                        : review.Decision == "Minor Revision"
                                                                                            ? "Küçük Revizyon"
                                                                                            : review.Decision == "Major Revision"
                                                                                                ? "Büyük Revizyon"
                                                                                                : review.Decision == "Reject"
                                                                                                    ? "Ret"
                                                                                                    : review.Decision
                                                                                )
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }

                                                                @if (review.SubmittedAt.HasValue)
                                                                {
                                                                    <div class="col-md-3">
                                                                        <div class="metric-box">
                                                                            <div class="metric-title">Gönderim Tarihi</div>
                                                                            <div class="metric-value small-value">
                                                                                @review.SubmittedAt.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>

                                                            @if (!string.IsNullOrWhiteSpace(review.CommentToAuthor))
                                                            {
                                                                <div class="mb-3">
                                                                    <div class="section-title">Yazara Yorum</div>
                                                                    <div class="content-box">@review.CommentToAuthor</div>
                                                                </div>
                                                            }

                                                            @if (!string.IsNullOrWhiteSpace(review.CommentToEditor))
                                                            {
                                                                <div class="mb-3">
                                                                    <div class="section-title">Editöre Gizli Yorum</div>
                                                                    <div class="content-box">@review.CommentToEditor</div>
                                                                </div>
                                                            }

                                                            @if (!string.IsNullOrWhiteSpace(review.Strengths))
                                                            {
                                                                <div class="mb-3">
                                                                    <div class="section-title">Güçlü Yönler</div>
                                                                    <div class="content-box">@review.Strengths</div>
                                                                </div>
                                                            }

                                                            @if (!string.IsNullOrWhiteSpace(review.Weaknesses))
                                                            {
                                                                <div class="mb-3">
                                                                    <div class="section-title">Geliştirilmesi Gereken Yönler</div>
                                                                    <div class="content-box">@review.Weaknesses</div>
                                                                </div>
                                                            }

                                                            @if (!string.IsNullOrWhiteSpace(review.ReviewerAttachmentPath))
                                                            {
                                                                <div class="mb-3">
                                                                    <div class="section-title">Hakem Ek Dosyası</div>
                                                                    <a href="@Url.Content(review.ReviewerAttachmentPath)"
                                                                       target="_blank"
                                                                       class="btn btn-sm btn-outline-primary">
                                                                        @(review.ReviewerAttachmentOriginalFileName ?? "Hakem ek dosyasını aç")
                                                                    </a>
                                                                </div>
                                                            }

                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info mb-0">
                                            Bu tura ait hakem raporu henüz gönderilmedi.
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SAĞ KARAR KOLONU -->
        <div class="review-side">
            <div class="decision-actions-card mb-3">
                <h5 class="fw-bold mb-3">@Model.CurrentReviewRound. Tur Hakem Atama</h5>

                @if ((Model.Status == SubmissionStatus.AlanEditorunde ||
                  Model.Status == SubmissionStatus.HakemAtamasiBekliyor ||
                  Model.Status == SubmissionStatus.HakemDegerlendirmesinde ||
                  Model.Status == SubmissionStatus.RevizyonYuklendi) &&
                 (!allReviewsCompleted || canAssignAdditionalReviewer))
                {
                    if (reviewers.Any())
                    {
                        <form asp-controller="Submission"
                              asp-action="AssignReviewerToCurrentRound"
                              method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="submissionId" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Hakem Seç</label>
                                <select name="reviewerId" class="form-select" required>
                                    <option value="">Hakem seçiniz</option>

                                    @foreach (var reviewer in reviewers)
                                    {
                                        <option value="@reviewer.Id">
                                            @(reviewer.FullName ?? reviewer.UserName ?? reviewer.Email)
                                        </option>
                                    }
                                </select>
                            </div>

                            <button type="submit"
                                    class="btn btn-outline-primary w-100 fw-bold">
                                @(canAssignAdditionalReviewer ? "Ek / 3. Hakem Ata" : $"{Model.CurrentReviewRound}. Tur İçin Hakem Ata")
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            Sistemde hakem rolüne sahip kullanıcı bulunamadı.
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-light border mb-0">
                        @if (allReviewsCompleted && !hasConflictingReviews)
                        {
                            <span>Bu turdaki hakem değerlendirmeleri tamamlandı. Artık karar aşamasındasınız.</span>
                        }
                        else
                        {
                            <span>Bu durumda hakem ataması yapılamaz.</span>
                        }
                    </div>
                }

                @{
                    var currentRoundReviewers = allAssignments
                        .Where(sr => sr.ReviewRound == Model.CurrentReviewRound)
                        .OrderByDescending(sr => sr.AssignedAt)
                        .ToList();
                }

                @if (currentRoundReviewers.Any())
                {
                    <div class="mt-4">
                        <div class="fw-bold mb-2">Bu Turdaki Hakemler</div>

                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Hakem</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sr in currentRoundReviewers)
                                {
                                    <tr>
                                        <td>
                                            @(sr.Reviewer?.FullName ?? sr.Reviewer?.UserName ?? sr.Reviewer?.Email ?? "-")
                                        </td>
                                        <td>
                                            <span class="badge @StatusDisplayHelper.GetReviewerAssignmentBadgeClass(sr.Status)">
                                                @StatusDisplayHelper.GetReviewerAssignmentStatusText(sr.Status)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="decision-actions-card">
                <h5 class="fw-bold mb-3">Editör Kararı</h5>

                <div class="decision-current-info mb-3">
                    <div>
                        <strong>Mevcut Durum:</strong>
                        <span>@StatusDisplayHelper.GetSubmissionStatusText(Model.Status)</span>
                    </div>

                    <div>
                        <strong>Aktif Tur:</strong>
                        <span>@Model.CurrentReviewRound. Tur</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.DecisionNote))
                    {
                        <div class="mt-2 small text-muted">
                            <strong>Son Editör Notu:</strong>
                            <div>@Model.DecisionNote</div>
                        </div>
                    }
                </div>

                @if (!allReviewsCompleted &&
                     (Model.Status == SubmissionStatus.HakemDegerlendirmesinde ||
                      Model.Status == SubmissionStatus.HakemAtamasiBekliyor))
                {
                    <div class="alert alert-warning border-0 rounded-4">
                        Hakem değerlendirmeleri tamamlanmadan karar veriyorsunuz. Gerekirse bekleyebilirsiniz.
                    </div>
                }

                <form asp-action="EditorDecision" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Yazara Not</label>
                        <textarea name="decisionNote"
                                  class="form-control decision-note"
                                  rows="6"
                                  placeholder="Yazara gönderilecek karar notu">@Model.DecisionNote</textarea>
                    </div>

                    @if (isFinalDecisionGiven)
                    {
                        <div class="alert alert-light border rounded-4 mb-3">
                            Bu gönderi için nihai karar verilmiştir. Karar butonları kapalıdır.
                        </div>

                        <button type="button" class="btn btn-warning w-100 mb-2" disabled>
                            Revizyon İste
                        </button>

                        <button type="button" class="btn btn-primary w-100 mb-2" disabled>
                            Gönderiyi Kabul Et
                        </button>

                        <button type="button" class="btn btn-outline-danger w-100" disabled>
                            Gönderiyi Reddet
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                name="decision"
                                value="revision"
                                class="btn btn-warning w-100 mb-2 fw-bold">
                            Revizyon İste
                        </button>

                        <button type="submit"
                                name="decision"
                                value="accept"
                                class="btn btn-primary w-100 mb-2 fw-bold">
                            Gönderiyi Kabul Et
                        </button>

                        <button type="submit"
                                name="decision"
                                value="reject"
                                class="btn btn-outline-danger w-100 fw-bold">
                            Gönderiyi Reddet
                        </button>
                    }
                </form>
            </div>

            <a asp-controller="Submission"
               asp-action="Detail"
               asp-route-id="@Model.Id"
               class="btn btn-outline-dark w-100 mt-3">
                Makale Detayı
            </a>
        </div>
    </div>
</div>

