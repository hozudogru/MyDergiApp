    .review-report-card {
        background: #fcfcfd;
    }

    .section-mini-title {
        font-size: .9rem;
        font-weight: 700;
        margin-bottom: .45rem;
        color: #1f2937;
    }

    .review-text-box {
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        padding: .9rem 1rem;
        white-space: pre-line;
        line-height: 1.65;
        min-height: 56px;
    }

    .review-private-note {
        background: #fff8e1;
        border-color: #f4d27a;
    }

    .score-box,
    .decision-summary-box {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        padding: .85rem 1rem;
        height: 100%;
    }
</style>