@model IEnumerable<MyDergiApp.ViewModels.UserListViewModel>

@using System.Security.Claims

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var users = Model?.ToList() ?? new List<MyDergiApp.ViewModels.UserListViewModel>();
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1 class="fw-bold mb-2">Kullanıcı Yönetimi</h1>
                <p class="text-muted mb-0">
                    Sistemde kayıtlı kullanıcıları, rollerini ve aktif/pasif durumlarını buradan yönetebilirsiniz.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="UserManagement"
                   asp-action="MailTest"
                   class="btn btn-warning rounded-3">
                    <i class="bi bi-envelope-check me-1"></i>
                    Mail Test
                </a>

                <a asp-controller="UserManagement"
                   asp-action="Create"
                   class="btn btn-success rounded-3">
                    <i class="bi bi-person-plus me-1"></i>
                    Yeni Kullanıcı
                </a>
            </div>
        </div>
    </div>
</div>

<form id="antiForgeryForm" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100 rounded-4">
            <div class="card-body">
                <div class="text-muted small mb-2">Toplam Kullanıcı</div>
                <div class="fs-2 fw-bold">@users.Count</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100 rounded-4">
            <div class="card-body">
                <div class="text-muted small mb-2">Aktif</div>
                <div class="fs-2 fw-bold text-success">@users.Count(x => x.IsActive)</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100 rounded-4">
            <div class="card-body">
                <div class="text-muted small mb-2">Pasif</div>
                <div class="fs-2 fw-bold text-danger">@users.Count(x => !x.IsActive)</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h5 class="fw-bold mb-1">Kullanıcı Listesi</h5>
                <p class="text-muted small mb-0">
                    Kayıtlı kullanıcıları görüntüleyebilir, rollerini düzenleyebilir ve aktif/pasif durumlarını yönetebilirsiniz.
                </p>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="usersTable" class="table align-middle mb-0 user-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Ad Soyad</th>
                        <th>Email</th>
                        <th>Durum</th>
                        <th>Rol</th>
                        <th>Oluşturulma</th>
                        <th class="text-end pe-4" style="width: 340px;">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in users)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@item.FullName</td>
                            <td>@item.Email</td>

                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                    @(item.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var role in item.Roles)
                                    {
                                        var roleClass = role.Trim().ToLower() switch
                                        {
                                            "admin" => "role-badge role-admin",
                                            "editor" => "role-badge role-editor",
                                            "chiefeditor" => "role-badge role-chiefeditor",
                                            "reviewer" => "role-badge role-reviewer",
                                            "author" => "role-badge role-author",
                                            "reader" => "role-badge role-reader",
                                            _ => "role-badge role-default"
                                        };

                                        <span class="@roleClass">@role</span>
                                    }
                                </div>
                            </td>

                            <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>

                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square"></i>
                                        Düzenle
                                    </a>

                                    <a asp-action="EditRoles"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-people"></i>
                                        Roller
                                    </a>

                                    @if (item.Id == currentUserId || item.Roles.Contains("Admin"))
                                    {
                                        <button type="button"
                                                class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                disabled
                                                title="Kendi hesabınız veya Admin kullanıcı pasif yapılamaz">
                                            <i class="bi @(item.IsActive ? "bi-x-circle" : "bi-check-circle")"></i>
                                            @(item.IsActive ? "Pasif Yap" : "Aktif Yap")
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") toggle-status"
                                                data-id="@item.Id">
                                            <i class="bi @(item.IsActive ? "bi-x-circle" : "bi-check-circle")"></i>
                                            @(item.IsActive ? "Pasif Yap" : "Aktif Yap")
                                        </button>
                                    }

                                    @if (User.IsInRole("Admin") && !item.Roles.Contains("Admin"))
                                    {
                                        if (!item.HasSubmissions)
                                        {
                                            <form asp-action="Delete"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bu kullanıcı silinsin mi?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                    Sil
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Makalesi var</span>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .user-table thead th {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #64748b;
        font-weight: 700;
        border-bottom: 1px solid #e5e7eb;
        padding-top: 14px;
        padding-bottom: 14px;
        white-space: nowrap;
    }

    .user-table tbody td {
        padding-top: 14px;
        padding-bottom: 14px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .user-table tbody tr:hover {
        background: #f8fafc;
    }

    .user-table .badge {
        font-weight: 600;
        padding: .45rem .65rem;
        border-radius: 999px;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        padding: .35rem .6rem;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .role-admin {
        color: #991b1b;
        background: #fee2e2;
        border-color: #fecaca;
    }

    .role-chiefeditor {
        color: #581c87;
        background: #f3e8ff;
        border-color: #e9d5ff;
    }

    .role-editor {
        color: #075985;
        background: #e0f2fe;
        border-color: #bae6fd;
    }

    .role-reviewer {
        color: #92400e;
        background: #fef3c7;
        border-color: #fde68a;
    }

    .role-author {
        color: #166534;
        background: #dcfce7;
        border-color: #bbf7d0;
    }

    .role-reader,
    .role-default {
        color: #334155;
        background: #f1f5f9;
        border-color: #e2e8f0;
    }

    div.dataTables_wrapper div.dataTables_length,
    div.dataTables_wrapper div.dataTables_filter {
        padding: 16px 24px 8px 24px;
    }

    div.dataTables_wrapper div.dataTables_info,
    div.dataTables_wrapper div.dataTables_paginate {
        padding: 12px 24px 16px 24px;
    }

    div.dataTables_wrapper div.dataTables_filter input {
        border-radius: 12px;
        border: 1px solid #d1d5db;
        padding: .45rem .75rem;
        margin-left: .5rem;
    }

    div.dataTables_wrapper div.dataTables_length select {
        border-radius: 10px;
        border: 1px solid #d1d5db;
        padding: .35rem 1.75rem .35rem .6rem;
    }
</style>

@section Scripts {
    <script>
        $(function () {
            $('#usersTable').DataTable({
                retrieve: true,
                info: false,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/tr.json'
                },
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                order: [[4, 'desc']],
                columnDefs: [
                    { orderable: false, targets: 5 }
                ],
                responsive: true,
                autoWidth: false
            });

            $(document).on('click', '.toggle-status', function () {
                const button = $(this);
                const id = button.data('id');
                const token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();

                if (!id) {
                    alert('Kullanıcı bilgisi alınamadı.');
                    return;
                }

                const currentText = button.text().trim();
                const confirmMessage = currentText.includes('Pasif')
                    ? 'Bu kullanıcı pasif yapılsın mı?'
                    : 'Bu kullanıcı aktif yapılsın mı?';

                if (!confirm(confirmMessage)) {
                    return;
                }

                button.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ToggleActive", "UserManagement")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: token
                    },
                    success: function (response) {
                        if (!response || !response.success) {
                            alert(response && response.message ? response.message : 'İşlem başarısız.');
                            button.prop('disabled', false);
                            return;
                        }

                        location.reload();
                    },
                    error: function () {
                        alert('İşlem sırasında hata oluştu.');
                        button.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
