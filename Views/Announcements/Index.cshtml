@model IEnumerable<MyDergiApp.Models.Announcement>
@{
    ViewData["Title"] = "Duyurular";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Duyurular</h2>
        <div class="text-muted small">Duyuruları ekleyebilir, düzenleyebilir, aktif/pasif yapabilir veya popup olarak seçebilirsiniz.</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">Yeni Duyuru</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Başlık</th>
                            <th>Tarih</th>
                            <th>Aktif</th>
                            <th>Popup</th>
                            <th style="width:300px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.Title</div>
                                    <div class="small text-muted text-truncate" style="max-width:520px;">
                                        @item.Content
                                    </div>
                                </td>
                                <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td>
                                    @if (item.ShowAsPopup)
                                    {
                                        <span class="badge bg-warning text-dark">Popup</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Hayır</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Düzenle</a>

                                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                @(item.IsActive ? "Pasif Yap" : "Aktif Yap")
                                            </button>
                                        </form>

                                        <form asp-action="TogglePopup" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                                @(item.ShowAsPopup ? "Popup Kaldır" : "Popup Yap")
                                            </button>
                                        </form>

                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu duyuru silinsin mi?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">Henüz duyuru eklenmemiş.</div>
        }
    </div>
</div>
