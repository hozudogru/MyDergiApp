@{
    ViewData["Title"] = "Sayılar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var upcomingIssues = ViewBag.UpcomingIssues as List<Issue>;
    var publishedIssues = ViewBag.PublishedIssues as List<Issue>;
}

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Sayılar</h1>
            <p>Dergi sayılarınızı oluşturun, düzenleyin ve yayımlayın.</p>
        </div>

        <a asp-controller="AdminIssue" asp-action="Create" class="admin-primary-btn">
            Yeni Sayı Yarat
        </a>
    </div>

    <div class="issue-tabs">
        <button class="issue-tab active" onclick="showIssueTab('upcoming')">Gelecek Sayılar</button>
        <button class="issue-tab" onclick="showIssueTab('published')">Önceki Sayılar</button>
    </div>

    <div id="upcoming" class="issue-tab-content active">
        <div class="issue-card">
            <h2>Gelecek Sayılar</h2>

            @if (upcomingIssues != null && upcomingIssues.Any())
            {
                foreach (var issue in upcomingIssues)
                {
                    <div class="issue-row">
                        <div>
                            <a asp-controller="AdminIssue" asp-action="Manage" asp-route-id="@issue.Id" class="issue-title">
                                Cilt @issue.Volume Sayı @issue.Number (@issue.Year)
                            </a>

                            <div class="issue-actions">
                                <a asp-controller="AdminIssue" asp-action="Manage" asp-route-id="@issue.Id">Düzenle</a>
                                <a asp-controller="AdminIssue" asp-action="Preview" asp-route-id="@issue.Id">Önizleme</a>

                                <form asp-controller="AdminIssue" asp-action="Publish" asp-route-id="@issue.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" onclick="return confirm('Bu sayıyı yayımlamak istiyor musunuz?')">
                                        Sayıyı Yayınla
                                    </button>
                                </form>

                                <a class="danger-link" asp-controller="AdminIssue" asp-action="Delete" asp-route-id="@issue.Id">Sil</a>
                            </div>
                        </div>

                        <div class="issue-count">
                            <strong>@(issue.IssueArticles?.Count ?? 0)</strong>
                            <span>Öğe</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    Gelecek sayı bulunmamaktadır.
                </div>
            }
        </div>
    </div>

    <div id="published" class="issue-tab-content">
        <div class="issue-card">
            <h2>Önceki Sayılar</h2>

            @if (publishedIssues != null && publishedIssues.Any())
            {
                foreach (var issue in publishedIssues)
                {
                    <div class="issue-row">
                        <div>
                            <a asp-controller="AdminIssue" asp-action="Manage" asp-route-id="@issue.Id" class="issue-title">
                                Cilt @issue.Volume Sayı @issue.Number (@issue.Year)
                            </a>

                            <div class="issue-actions">
                                <a asp-controller="AdminIssue" asp-action="Manage" asp-route-id="@issue.Id">Düzenle</a>
                                <a asp-controller="AdminIssue" asp-action="Preview" asp-route-id="@issue.Id">Önizleme</a>
                            </div>
                        </div>

                        <div class="issue-count">
                            <strong>@(issue.IssueArticles?.Count ?? 0)</strong>
                            <span>Öğe</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    Önceki sayı bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>

<script>
    function showIssueTab(tabId) {
        document.querySelectorAll('.issue-tab').forEach(x => x.classList.remove('active'));
        document.querySelectorAll('.issue-tab-content').forEach(x => x.classList.remove('active'));

        event.target.classList.add('active');
        document.getElementById(tabId).classList.add('active');
    }
</script>